# Local development only. Percent-encode reserved characters in URL passwords.
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://analytics:change-me-local-only@localhost:5432/analytics
LOG_LEVEL=INFO
DATABASE_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_TIMEOUT_SECONDS=30

# Optional provider boundary. No provider adapter is included in this release.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
